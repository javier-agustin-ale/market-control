NODE_ENV=production

# Supabase PostgreSQL
# Prefer the Supabase pooler connection string for serverless hosting.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
AUTH_COOKIE_MAX_AGE_MS=28800000

# Frontend origin allowed by CORS, without a trailing slash.
CLIENT_ORIGIN=https://your-frontend-project.vercel.app

# Account-request emails
RESEND_API_KEY=re_replace-with-your-resend-key
PERSONAL_EMAIL=you@example.com
